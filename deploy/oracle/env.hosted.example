# /opt/gg/app/.env on the hosted vm (0600, owner deploy); bootstrap.sh fills the marked values.
# names only: real keys are pasted on the vm and never committed.
GG_ENV=prod
GG_LOG_FORMAT=json
GG_MODEL_PROFILE=demo

# compose-only settings (the gateway ignores GG_DEPLOY_*)
GG_PUBLIC_HOST=__GG_PUBLIC_HOST__
GG_DEPLOY_KEYS_FILE=/opt/gg/keys.yaml
GG_DEPLOY_LANGFUSE_HOST=https://cloud.langfuse.com
COMPOSE_PROFILES=hosted

# kill switch: 1 turns /v1/* into 503 for every key not tagged admin; apply with `deploy.sh restart`
GG_MAINTENANCE=0
# per-ip failed-auth limiter
GG_AUTH_FAILURES__MAX_FAILURES=10
GG_AUTH_FAILURES__WINDOW_S=60

# provider keys: free tiers first (demo profile); paid keys stay unset unless their caps are set below
GG_PROVIDERS__GEMINI__API_KEY=
GG_PROVIDERS__GROQ__API_KEY=
GG_PROVIDERS__OPENAI__API_KEY=
GG_PROVIDERS__ANTHROPIC__API_KEY=

# gateway-wide spend caps in usd; unlisted providers get $0
GG_SPEND_CAP_DAILY_USD=openai=0.50,anthropic=0.50,gemini=0.50
GG_SPEND_CAP_TOTAL_USD=openai=1.00,anthropic=1.00,gemini=1.00
GG_SPEND_CAP_RUN_USD=1.00

GG_JEV_API_KEY=
GG_PROMPTGUARD_API_KEY=
GG_GRAFANA_ADMIN_PASSWORD=__GRAFANA_PASSWORD__

# langfuse cloud (optional); unset keys turn tracing off
GG_LANGFUSE__PUBLIC_KEY=
GG_LANGFUSE__SECRET_KEY=
GG_LANGFUSE__CAPTURE_CONTENT=scrubbed
