# copy to .env; only GG_-prefixed variables are read
GG_ENV=dev
GG_LOG_FORMAT=console
# models.yaml profile: dev-free | prod | ci | loadtest
GG_MODEL_PROFILE=dev-free

# provider credentials, keyed by provider name in config/models.yaml
GG_PROVIDERS__OPENAI__API_KEY=
GG_PROVIDERS__ANTHROPIC__API_KEY=
GG_PROVIDERS__GEMINI__API_KEY=
GG_PROVIDERS__GROQ__API_KEY=
GG_PROVIDERS__DEEPINFRA__API_KEY=
GG_PROVIDERS__OPENROUTER__API_KEY=
GG_PROVIDERS__ZAI__API_KEY=
GG_PROVIDERS__DEEPSEEK__API_KEY=
# coding-plan subscription keys
GG_PROVIDERS__ZAI_CODING__API_KEY=
GG_PROVIDERS__QWEN_CODING__API_KEY=
GG_PROVIDERS__MINIMAX_CODING__API_KEY=
# base url overrides, e.g. the local mock upstream or ollama
GG_PROVIDERS__MOCK_HTTP__BASE_URL=http://localhost:9000/v1
GG_PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434/v1

# spend caps in usd: "openai=1.00,gemini=0.50" or one amount for every provider; unlisted providers get $0
GG_SPEND_CAP_DAILY_USD=openai=1.00,anthropic=1.00,gemini=0.50
GG_SPEND_CAP_TOTAL_USD=openai=5.00,anthropic=5.00,gemini=2.00
GG_SPEND_CAP_RUN_USD=1.00

GG_JEV_API_KEY=
# promptguard.co guard api key (pg_live_...); unset drops the promptguard guards from every policy
GG_PROMPTGUARD_API_KEY=
# local guard model weights (ml extra); unset keeps the ml guards off
GG_MODELS_DIR=.models
GG_REDIS_URL=redis://localhost:6379/0
GG_GRAFANA_ADMIN_PASSWORD=

# langfuse tracing; unset keys turn it off. local stack: docker compose --profile langfuse up (ui :3001)
GG_LANGFUSE__HOST=http://localhost:3001
# any pk-lf-/sk-lf- pair; the local stack creates its project with this pair on first boot
GG_LANGFUSE__PUBLIC_KEY=
GG_LANGFUSE__SECRET_KEY=
# off | scrubbed (placeholder-space prompt and reply, masked)
GG_LANGFUSE__CAPTURE_CONTENT=scrubbed
GG_LANGFUSE__SAMPLE_RATE=1.0
# local langfuse stack only (openssl rand -hex 32 for each secret)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ADMIN_EMAIL=admin@gg.local
LANGFUSE_ADMIN_PASSWORD=

# demo safety: 1 turns /v1/* into 503 for every key not tagged admin (health endpoints stay up)
GG_MAINTENANCE=0
# per-ip failed-auth limiter on /v1/*: this many 401s in one window earn the ip a 429 until it ends
GG_AUTH_FAILURES__MAX_FAILURES=10
GG_AUTH_FAILURES__WINDOW_S=60

# docker compose only (the gateway ignores GG_DEPLOY_*); see docs/deploy.md
GG_DEPLOY_PORT=8000
GG_DEPLOY_KEYS_FILE=./config/keys.yaml
GG_DEPLOY_LANGFUSE_HOST=http://langfuse-web:3000
# hosted profile (caddy + let's encrypt): the public dns name of the vm
GG_PUBLIC_HOST=
